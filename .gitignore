# Generated corpus copies, reports, and compiled binaries.
# The race corpus is copied from GOROOT on every run and never committed.
/build/
/gosree
/gosree-erase
/gosree-corpus

# Go test binaries, coverage profiles, and atomic-rewrite temp files
*.test
*.out
coverage.*
.gosree-erase-*.tmp

# A root go.work breaks cmd/gosree-corpus on its nested test modules. Point at an
# unpublished gusset with a temporary `go mod edit -replace` instead.
/go.work
/go.work.sum

# Rust build artifacts (gusset engine & solver crates)
/rust/target/
/rust/*/target/

# Lean 4 Lake build artifacts
.lake/

# Agent, code-intelligence, and IDE workspace state
/.devcouncil/
/.claude/
/.claude-account
/.cursor/
/.gemini/
/.vscode/
/.idea/

# OS & local environment files (never commit secrets or local env)
.DS_Store
.env
.env.*
