--- /dev/null
+++ b/passes/errcheck/testdata/src/errc7ddedge/a.go
@@ -0,0 +1,121 @@
+package errc7ddedge
+
+import "io"
+
+func open() io.WriteCloser { return nil }
+
+type holder struct{ w io.WriteCloser }
+
+// ---- (a) A closure that stores to the captured variable ----
+
+// MISS (ft-c7dd): the deferred Close is bound to the resource w holds when the defer runs, which
+// the closure writes and then replaces. Replaying the write on w's slot would also report the
+// reassigned-in-body shape that advfvbreak3b3c pins as clean, since both share one slot per
+// variable and a deferred close is judged against the slot's state at exit. Nothing is reported.
+func storeAfterWrite(w io.WriteCloser) {
+	defer w.Close()
+	func() {
+		_, _ = w.Write(nil)
+		w = open()
+	}()
+}
+
+// Twin without a closure: the deferred Close holds the old resource, written, and is reported.
+func storeAfterWriteTwin(w io.WriteCloser) {
+	defer w.Close() // want "ERR005"
+	_, _ = w.Write(nil)
+	w = open()
+}
+
+// The closure replaces the resource and closes the new one: nothing was written to it.
+func storeThenCloseInClosure(w io.WriteCloser) {
+	_, _ = w.Write(nil)
+	func() {
+		w = open()
+		w.Close()
+	}()
+}
+
+// ---- (b) A field path written in a closure, closed in the parent, and the reverse ----
+
+func fieldWriteInClosure(h *holder) {
+	defer h.w.Close() // want "ERR005"
+	func() { _, _ = h.w.Write(nil) }()
+}
+
+func fieldWriteInClosureTwin(h *holder) {
+	defer h.w.Close() // want "ERR005"
+	_, _ = h.w.Write(nil)
+}
+
+func fieldCloseInClosure(h *holder) {
+	_, _ = h.w.Write(nil)
+	func() { h.w.Close() }() // want "ERR005"
+}
+
+func fieldCloseInClosureTwin(h *holder) {
+	_, _ = h.w.Write(nil)
+	h.w.Close() // want "ERR005"
+}
+
+func fieldDeferredCloseInClosure(h *holder) {
+	_, _ = h.w.Write(nil)
+	defer func() { h.w.Close() }() // want "ERR005"
+}
+
+// A different field of the same holder is not the written one.
+type pair struct{ a, b io.WriteCloser }
+
+func otherFieldInClosure(p *pair) {
+	_, _ = p.a.Write(nil)
+	func() { p.b.Close() }()
+}
+
