+++ b/passes/errcheck/testdata/src/errc7ddblank/a.go
@@ -0,0 +1,38 @@
+package errc7ddblank
+
+import "io"
+
+// ---- ERR003 on an explicit blank discard in a loop ----
+
+func s6BlankInLoop(w io.WriteCloser) {
+	for i := 0; i < 2; i++ {
+		_, _ = w.Write(nil)
+	}
+}
+
+func s6BlankInLoopClosure(w io.WriteCloser) func() {
+	return func() {
+		for i := 0; i < 2; i++ {
+			_, _ = w.Write(nil)
+		}
+	}
+}
+
+func s6ReassignInLoop(w io.WriteCloser) {
+	var err error
+	for i := 0; i < 2; i++ {
+		_, err = w.Write(nil) // want "ERR003"
+	}
+	_ = err
+}
+
+func s6ReassignInLoopRead(w io.WriteCloser) error {
+	var err error
+	for i := 0; i < 2; i++ {
+		_, err = w.Write(nil)
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/passes/errcheck/testdata/src/errc7ddblank/b.go b/passes/errcheck/testdata/src/errc7ddblank/b.go
new file mode 100644
index 0000000..b8e8dbe
--- /dev/null
+++ b/passes/errcheck/testdata/src/errc7ddblank/b.go
@@ -0,0 +1,38 @@
+package errc7ddblank
+
+import "io"
+
+
+func marshal() ([]byte, error) { return nil, nil }
+
+func payload() []byte { return nil }
+
+// ft-c7dd: a call that shares its line with an all-blank assignment must not take that assignment
+// as its own: marshal's error is checked on the next line and stays tracked, the blanked Write is
+// silent in the loop, and the use of b before the check is still reported.
+func sameLineNeighbour(w io.Writer) error {
+	for i := 0; i < 2; i++ {
+		b, err := marshal(); _, _ = w.Write(nil)
+		if err != nil {
+			return err
+		}
+		_ = b
+	}
+	return nil
+}
+
+func sameLineUseBeforeCheck(w io.Writer) error {
+	for i := 0; i < 2; i++ {
+		b, err := marshal(); _, _ = w.Write(b) // want "ERR002"
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func sameLineNested(w io.Writer) {
+	for i := 0; i < 2; i++ {
+		_, _ = w.Write(payload())
+	}
+}
