+func holderReassigned(h, other *H) {
+	_, _ = h.w.Write(nil)
+	h = other
+	h.w.Close()
+}
+
+// ... when another closure captures it, its loads share one root and the old write is carried over.
+func holderReassignedCaptured(h, other *H) {
+	f := func() { _ = h }
+	_, _ = h.w.Write(nil)
+	h = other
+	h.w.Close()
+	f()
+}
