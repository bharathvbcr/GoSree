+func ptrArgReset(h *H) {
+	_, _ = h.w.Write(nil)
+	swapW(&h.w)
+	h.w.Close()
+}
+
+func ptrArgResetLocal(w io.WriteCloser) {
+	_, _ = w.Write(nil)
+	swapW(&w)
+	w.Close()
+}
+
