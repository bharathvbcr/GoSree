+package errcheck_test
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+
+	"golang.org/x/tools/go/analysis/analysistest"
+
+	"github.com/bharathvbcr/gosree/passes/errcheck"
+)
+
+// Adversarial review of ft-c7dd (567e3d5..498984f), against the unmodified tip 90fa6e9. Every shape
+// is written next to its plain twin; a closure or field form whose diagnostics differ from its
+// twin's is a finding. The Break tests fail at 498984f on purpose: each asserts the correct result.
+
+// Shapes the fix handles as its twin does, plus the pre-existing limitations (commented MISS) and
+// the pre-existing false positive of a slot defined inside a loop (pinned with a want).
+func TestAdvC7ddDefended(t *testing.T) {
+	analysistest.Run(t, analysistest.TestData(), errcheck.Analyzer, "errc7ddadv")
+}
+
+// BREAK (new false positives): nothing in errc7ddadvfp is reported on 90fa6e9, and in every
+// function the Close is of a resource that was not written. The package has no want markers.
+//
+//	callReset, ptrArgReset, ptrArgResetLocal, otherHolderParam: a call or an unknown alias replaces
+//	the resource, so the path's written flag is stale (the path slot is reset only by a store the
+//	function itself makes, lower.go:1276).
+//	holderReassignedCaptured: loads of a captured holder variable share one root cell, so a write
+//	through the old holder is carried to the new one (valueKeyOf, lower.go:320).
+//	escapeBranch, escapeReplaced: seedEscapedCloses seeds from bindingMayBeWritten, which is
+//	flow-insensitive (closureeffects.go, bindingMayBeWritten).
+//	deferInClosureThenWrite: a defer inside a closure is replayed as a deferred close of the
+//	creator, judged at the creator's exit (replayClosureEffects, closureeffects.go:295, IsDefer: isDefer || c.deferred).
+//	compareIsNotARun, registeredThenClosed: writes are replayed at every use of the closure value.
+func TestAdvC7ddBreakNewFalsePositives(t *testing.T) {
+	analysistest.Run(t, analysistest.TestData(), errcheck.Analyzer, "errc7ddadvfp")
+}
+
+// BREAK (new misses): each ERR005 here is reported on 90fa6e9 and silent at 498984f. The alias
+// holds the written resource; the later store to the field or pointer resets the path slot that
+// the alias's load is keyed to (lower.go, the Store case, and resourceSlot's valueKey). The plain
+// twin aliasThenReplaceTwin is still reported.
+func TestAdvC7ddBreakNewMiss(t *testing.T) {
+	analysistest.Run(t, analysistest.TestData(), errcheck.Analyzer, "errc7ddadvmiss")
+}
+
+// BREAK (gap, not new): 90fa6e9 is silent here too, but the fix's claim is that a resource reached
+// through a field path is tracked, and a field of a field is not: valueKeyOf does not flatten a
+// chain of FieldAddr, so each use has its own root.
+func TestAdvC7ddBreakGapNestedField(t *testing.T) {
+	analysistest.Run(t, analysistest.TestData(), errcheck.Analyzer, "errc7ddadvgap")
+}
+
+// BREAK (duplicate diagnostics): a deferred closure that writes and then closes reports the Close
+// from the closure's own flow and again, as a deferred close, from the creator's replay.
+func TestAdvC7ddBreakDuplicateDeferredClose(t *testing.T) {
+	analysistest.Run(t, analysistest.TestData(), errcheck.Analyzer, "errc7ddadvdup")
+}
+
+// diagnosticsOf runs the analyzer on the packages and returns every diagnostic, in the order the
+// framework reports them, as "file:line:col: message".
+func diagnosticsOf(t *testing.T, pkgs ...string) []string {
+	t.Helper()
+	var out []string
+	for _, r := range analysistest.Run(&recordT{}, analysistest.TestData(), errcheck.Analyzer, pkgs...) {
+		for _, d := range r.Diagnostics {
+			p := r.Pass.Fset.Position(d.Pos)
+			out = append(out, fmt.Sprintf("%s:%d:%d: %s", filepath.Base(p.Filename), p.Line, p.Column, d.Message))
+		}
+	}
+	return out
+}
+
+// Ten runs give identical diagnostics in identical order, and the diagnostics equal the golden
+// list, which both engines (cgo/Rust and CGO_ENABLED=0/oracle) must reproduce byte for byte.
+func TestAdvC7ddDeterminismAndEngineParity(t *testing.T) {
+	pkgs := []string{"errc7ddadv", "errc7ddadvfp", "errc7ddadvmiss", "errc7ddadvgap", "errc7ddadvdup"}
+	first := diagnosticsOf(t, pkgs...)
+	if len(first) == 0 {
+		t.Fatal("no diagnostics")
+	}
+	for i := 1; i < 10; i++ {
+		got := diagnosticsOf(t, pkgs...)
+		if strings.Join(got, "\n") != strings.Join(first, "\n") {
+			t.Fatalf("run %d differs from run 0:\n%s\n---\n%s", i, strings.Join(got, "\n"), strings.Join(first, "\n"))
+		}
+	}
+	sorted := append([]string(nil), first...)
+	sort.Strings(sorted)
+	golden := filepath.Join(analysistest.TestData(), "adv_c7dd.golden")
+	want, err := os.ReadFile(golden)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := strings.Join(sorted, "\n") + "\n"; got != string(want) {
+		t.Fatalf("diagnostics differ from %s:\n%s", golden, got)
+	}
+}
