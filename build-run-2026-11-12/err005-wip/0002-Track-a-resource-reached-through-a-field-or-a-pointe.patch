 // through another meet on one slot. Only the monotone written flag uses it: a captured variable can
 // be reassigned by other code between loads, so nilness refinements must not flow across loads and
 // stay on rootSlot.
+//
+// A resource reached through a field or a pointer (`h.w`, `(*pw)`) keeps its flag on the slot of
+// its access path, so two loads of `h.w` meet on one slot the way two loads of a variable do.
 func (fl *funcLowerer) resourceSlot(v ssa.Value) uint32 {
+	if k, ok := fl.valueKey(v); ok && k.path != "" {
+		return fl.pathSlot(k)
+	}
 	if load, ok := v.(*ssa.UnOp); ok && load.Op == token.MUL {
 		if fv, ok := load.X.(*ssa.FreeVar); ok {
 			return fl.slot(fv)
@@ -273,6 +282,64 @@ func (fl *funcLowerer) resourceSlot(v ssa.Value) uint32 {
 	return fl.rootSlot(v)
 }
 
+// accessKey names a value by where it is read from: a root (a parameter, a captured variable, a
+// local cell or any other SSA value) and the dereferences and field selections applied to it.
+type accessKey struct {
+	root ssa.Value
+	path string
+}
+
+func (fl *funcLowerer) pathSlot(k accessKey) uint32 {
+	if s, ok := fl.pathSlots[k]; ok {
+		return s
+	}
+	s := fl.allocSlot(0)
+	fl.pathSlots[k] = s
+	return s
+}
+
+// valueKey is the access path of the value v. Only a load or a field selection has a path; every
+// other value is its own root with an empty path.
+func (fl *funcLowerer) valueKey(v ssa.Value) (accessKey, bool) {
+	switch x := v.(type) {
+	case *ssa.UnOp:
+		if x.Op == token.MUL {
+			return fl.addrKey(x.X)
+		}
+	case *ssa.Field:
+		if base, ok := fl.valueKey(x.X); ok {
+			return accessKey{base.root, base.path + "." + strconv.Itoa(x.Field)}, true
+		}
+	}
+	return accessKey{root: v}, true
+}
+
+// addrKey is the access path of the value stored at the address a. The address of a variable (a
+// captured variable or a local cell) is the root itself; a field address extends the path of the
+// pointer it selects from, and any other pointer is dereferenced.
+func (fl *funcLowerer) addrKey(a ssa.Value) (accessKey, bool) {
+	switch x := a.(type) {
+	case *ssa.FreeVar:
+		return accessKey{root: x}, true
+	case *ssa.Alloc:
+		if fl.localCells[x] {
+			return accessKey{root: x}, true
+		}
+	case *ssa.FieldAddr:
+		if base, ok := fl.valueKey(x.X); ok {
+			return accessKey{base.root, base.path + "->" + strconv.Itoa(x.Field)}, true
+		}
+		return accessKey{}, false
+	case *ssa.IndexAddr:
+		return accessKey{}, false
+	}
+	base, ok := fl.valueKey(a)
+	if !ok {
+		return accessKey{}, false
+	}
+	return accessKey{base.root, base.path + "*"}, true
+}
+
 func (fl *funcLowerer) mem2regErrSlot(v *types.Var) uint32 {
 	if s, ok := fl.mem2regErrSlots[v]; ok {
 		return s
@@ -1185,6 +1252,22 @@ func (fl *funcLowerer) build(flags uint8) gusseterr.FuncIR {
 							NilHint: gusseterr.AssignNilMayNil,
 						})
 					}
+					if k, ok := fl.addrKey(x.Addr); ok && k.path != "" {
+						// A store to a field or through a pointer replaces the resource that its
+						// path tracks: the slot takes the stored value's written state, as for a
+						// captured variable above.
+						src := gusseterr.NoneU32
+						if slotFlagsForType(x.Val.Type())&gusseterr.SlotIsError == 0 {
+							src = fl.resourceSlot(x.Val)
+						}
+						ops = append(ops, gusseterr.OpIR{
+							Kind:    gusseterr.OpAssignSlot,
+							SiteID:  0,
+							SlotA:   fl.pathSlot(k),
+							SlotB:   src,
+							NilHint: gusseterr.AssignNilMayNil,
+						})
+					}
 					if isErrorInterface(x.Val.Type()) || len(fl.valErrVars[x.Val]) > 0 {
 						fl.emitObserveErr(&ops, x.Val)
 					} else if !fl.closurePairStore(x) {
