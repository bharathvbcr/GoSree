--- /dev/null
+++ b/passes/errcheck/testdata/src/errc7ddfield/a.go
@@ -0,0 +1,77 @@
+package errc7ddfield
+
+import "io"
+
+func open() io.WriteCloser { return nil }
+
+// ---- Shape 3: field loads through a captured pointer ----
+
+type holder struct {
+	w io.WriteCloser
+	n int
+}
+
+func s3Field(h *holder) func() {
+	return func() {
+		_, _ = h.w.Write(nil)
+		defer h.w.Close() // want "ERR005"
+	}
+}
+
+func s3FieldTwin(h *holder) {
+	_, _ = h.w.Write(nil)
+	defer h.w.Close() // want "ERR005"
+}
+
+func s3FieldByRef() func() {
+	var h holder
+	h.w = open()
+	return func() {
+		_, _ = h.w.Write(nil)
+		defer h.w.Close() // want "ERR005"
+		h.n++
+	}
+}
+
+func s3PtrToIface(pw *io.WriteCloser) func() {
+	return func() {
+		_, _ = (*pw).Write(nil)
+		defer (*pw).Close() // want "ERR005"
+	}
+}
+
+func s3PtrToIfaceTwin(pw *io.WriteCloser) {
+	_, _ = (*pw).Write(nil)
+	defer (*pw).Close() // want "ERR005"
+}
+
+// The field is replaced between the write and the close: the new resource was never written.
+func s3FieldReassign(h *holder) {
+	_, _ = h.w.Write(nil)
+	h.w = open()
+	h.w.Close()
+}
+
+func s3FieldReassignClosure(h *holder) func() {
+	return func() {
+		_, _ = h.w.Write(nil)
+		h.w = open()
+		h.w.Close()
+	}
+}
+
+// Two different fields of one holder do not share a written flag.
+type pair struct{ a, b io.WriteCloser }
+
+func s3OtherField(p *pair) {
+	_, _ = p.a.Write(nil)
+	p.b.Close()
+}
+
+// A read-only resource reached through a field stays silent.
+type rholder struct{ r io.ReadCloser }
+
+func s3ReadOnlyField(h *rholder) {
+	_, _ = h.r.Read(nil)
+	defer h.r.Close()
+}
