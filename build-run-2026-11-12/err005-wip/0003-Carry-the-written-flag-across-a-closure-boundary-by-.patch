@@ -0,0 +1,205 @@
+package errc7dd
+
+import (
+	"io"
+	"iter"
+	"os"
+)
+
+func open() io.WriteCloser { return nil }
+
+func seq(n int) iter.Seq[int] {
+	return func(yield func(int) bool) {
+		for i := range n {
+			if !yield(i) {
+				return
+			}
+		}
+	}
+}
+
+// ---- Shape 1: parent defers Close, a closure does the write ----
+
+func s1Closure(f *os.File) {
+	defer f.Close() // want "ERR005"
+	func() { _, _ = f.Write(nil) }()
+}
+
+func s1Twin(f *os.File) {
+	defer f.Close() // want "ERR005"
+	_, _ = f.Write(nil)
+}
+
+// ---- Shape 2: closure closes, parent writes ----
+
+func s2Direct(f *os.File) {
+	_, _ = f.Write(nil)
+	func() { f.Close() }() // want "ERR005"
+}
+
+func s2Twin(f *os.File) {
+	_, _ = f.Write(nil)
+	f.Close() // want "ERR005"
+}
+
+func s2Deferred(f *os.File) {
+	defer func() { f.Close() }() // want "ERR005"
+	_, _ = f.Write(nil)
+}
+
+func s2Local() {
+	f, _ := os.Create("x")           // want "ERR002"
+	cl := func() { defer f.Close() } // want "ERR005"
+	_, _ = f.Write(nil)
+	cl()
+}
+
+// ---- Shape 4: nested closures ----
+
+func s4Nested(w io.WriteCloser) func() func() {
+	return func() func() {
+		_, _ = w.Write(nil)
+		return func() {
+			w.Close() // want "ERR005"
+		}
+	}
+}
+
+func s4NestedTwin(w io.WriteCloser) {
+	_, _ = w.Write(nil)
+	w.Close() // want "ERR005"
+}
+
+// ---- Shape 5: range-over-func ----
+
+func s5DeferBefore(w io.WriteCloser) {
+	defer w.Close() // want "ERR005"
+	for range seq(2) {
+		_, _ = w.Write(nil)
+	}
+}
+
+func s5DeferBeforeTwin(w io.WriteCloser) {
+	defer w.Close() // want "ERR005"
+	for i := 0; i < 2; i++ {
+		_, _ = w.Write(nil)
+	}
+}
+
+func s5BodyWritesClosureCloses(w io.WriteCloser) {
+	for range seq(2) {
+		_, _ = w.Write(nil)
+		func() { w.Close() }() // want "ERR005"
+	}
+}
+
+func s5WriteInClosureDeferInBody(w io.WriteCloser) {
+	write := func() { _, _ = w.Write(nil) }
+	for range seq(2) {
+		defer w.Close() // want "ERR005"
+		write()
+	}
+}
+
+func s5WriteAfterLoopInClosure(w io.WriteCloser) func() {
+	return func() {
+		for range seq(2) {
+			defer w.Close() // want "ERR005"
+		}
+		_, _ = w.Write(nil)
+	}
+}
+
+func s5WriteAfterLoopTwin(w io.WriteCloser) {
+	for i := 0; i < 2; i++ {
+		defer w.Close() // want "ERR005"
+	}
+	_, _ = w.Write(nil)
+}
+
+// ---- Ordering: the closure's effects land where it runs ----
+
+// The variable is replaced after the closure is made and before it runs, so the write that the
+// closure makes lands on the new resource: a mark at the closure's creation would have been erased.
+func orderReplaceBeforeCall(w io.WriteCloser) {
+	write := func() { _, _ = w.Write(nil) }
+	w = open()
+	write()
+	w.Close() // want "ERR005"
+}
+
+func orderReplaceBeforeCallTwin(w io.WriteCloser) {
+	w = open()
+	_, _ = w.Write(nil)
+	w.Close() // want "ERR005"
+}
+
+// The closure runs only after the Close: no write has happened when the resource is closed.
+func orderCloseBeforeCall(w io.WriteCloser) {
+	write := func() { _, _ = w.Write(nil) }
+	w.Close()
+	write()
+}
+
+// The closure writes, then the variable is replaced: the new resource was never written.
+func orderReplaceAfterCall(w io.WriteCloser) {
+	write := func() { _, _ = w.Write(nil) }
+	write()
+	w = open()
+	w.Close()
+}
+
+func orderReplaceAfterCallTwin(w io.WriteCloser) {
+	_, _ = w.Write(nil)
+	w = open()
+	w.Close()
+}
+
+// A closure that only reads leaves the resource read-only.
+func readOnlyClosure(r io.ReadCloser) {
+	defer r.Close()
+	func() { _, _ = r.Read(nil) }()
+}
+
+func readOnlyClosureTwin(r io.ReadCloser) {
+	defer r.Close()
+	_, _ = r.Read(nil)
+}
+
+// A closure that closes a resource nothing has written stays silent, called or returned.
+func closeOnlyClosure(w io.WriteCloser) func() {
+	func() { w.Close() }()
+	return func() { w.Close() }
+}
+
+// The close is checked: nothing is dropped, whoever wrote.
+func checkedCloseInClosure(w io.WriteCloser) error {
+	_, _ = w.Write(nil)
+	return func() error { return w.Close() }()
+}
+
+// ---- A captured variable assigned from a producer inside a closure, then closed ----
+
+func capturedCreate(p string) func() error {
+	var f *os.File
+	return func() error {
+		var err error
+		// Known false positive, not this card's: the closure stores the file to a captured variable
+		// before its own local err is checked (ft-420d's pair plan needs both in captured cells).
+		f, err = os.Create(p) // want "ERR002"
+		if err != nil {
+			return err
+		}
+		defer f.Close() // want "ERR005"
+		return nil
+	}
+}
+
+func capturedCreateTwin(p string) error {
+	f, err := os.Create(p)
+	if err != nil {
+		return err
+	}
+	defer f.Close() // want "ERR005"
+	return nil
+}
