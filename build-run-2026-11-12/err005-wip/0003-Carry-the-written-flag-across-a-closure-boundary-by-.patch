diff --git a/passes/errcheck/closureeffects.go b/passes/errcheck/closureeffects.go
new file mode 100644
index 0000000..0c512f2
--- /dev/null
+++ b/passes/errcheck/closureeffects.go
@@ -0,0 +1,361 @@
+package errcheck
+
+import (
+	"go/token"
+
+	"golang.org/x/tools/go/ssa"
+
+	"github.com/bharathvbcr/gosree/internal/gusseterr"
+)
+
+// A closure and the function that creates it are lowered separately, so the written flag of a
+// resource they share (ERR005) does not cross the boundary by itself. A closureEffects summarises
+// what one closure does to the variables it captures: which it may write, and which Close calls
+// whose error it drops. The creator replays those effects at the places the closure runs, on the
+// slots of the variables it passed in, so a write in a closure meets the Close of its creator and a
+// write of the creator meets the Close in the closure.
+//
+// The summary is flow-insensitive on the writes (a write anywhere in the closure may happen) and
+// leaves out what it cannot place: a close is replayed only where the closure demonstrably runs.
+
+type closeEffect struct {
+	idx      int       // free-variable index of the resource that is closed
+	pos      token.Pos // the Close statement
+	desc     string    // the receiver as written
+	deferred bool      // the close is a defer statement, in the closure or in the creator
+}
+
+type closureEffects struct {
+	writes []int
+	closes []closeEffect
+	stores []int // captured variables the closure assigns to
+}
+
+// A closure that stores to a captured variable replaces the resource in it, so a write it makes may
+// be to the old one: those writes are left out of the summary rather than replayed on the
+// resource that the creator closes afterwards.
+
+// astInfoFor scans the syntax of fn once, whichever of lowering and the closure summaries asks first.
+func (b *packageBuilder) astInfoFor(fn *ssa.Function) *funcASTInfo {
+	if ai, ok := b.astInfos[fn]; ok {
+		return ai
+	}
+	ai := scanFuncAST(b.pass, fn.Syntax())
+	b.astInfos[fn] = ai
+	return ai
+}
+
+// fvIndexOf returns the index of the captured variable that v reads or is, or -1.
+func fvIndexOf(fn *ssa.Function, v ssa.Value) int {
+	if load, ok := v.(*ssa.UnOp); ok && load.Op == token.MUL {
+		v = load.X
+	}
+	if fv, ok := v.(*ssa.FreeVar); ok {
+		return freeVarIndex(fn, fv)
+	}
+	return -1
+}
+
+// closuresRunBy returns the closures that ins runs: its callee, and the closures it takes as
+// arguments (a range-over-func body, a callback), which run while the call does.
+func closuresRunBy(ins ssa.Instruction) []*ssa.MakeClosure {
+	var cc *ssa.CallCommon
+	switch x := ins.(type) {
+	case *ssa.Call:
+		cc = &x.Call
+	case *ssa.Defer:
+		cc = &x.Call
+	case *ssa.Go:
+		cc = &x.Call
+	default:
+		return nil
+	}
+	var out []*ssa.MakeClosure
+	if m, ok := cc.Value.(*ssa.MakeClosure); ok && !cc.IsInvoke() {
+		out = append(out, m)
+	}
+	for _, arg := range cc.Args {
+		if m, ok := arg.(*ssa.MakeClosure); ok {
+			out = append(out, m)
+		}
+	}
+	return out
+}
+
+func (b *packageBuilder) closureEffectsFor(fn *ssa.Function) *closureEffects {
+	if e, ok := b.effects[fn]; ok {
+		return e
+	}
+	e := &closureEffects{}
+	b.effects[fn] = e
+	if len(fn.FreeVars) == 0 || len(fn.Blocks) == 0 {
+		return e
+	}
+	ast := b.astInfoFor(fn)
+	wrote := make(map[int]bool)
+	stored := make(map[int]bool)
+	addWrite := func(idx int) {
+		if idx >= 0 && !wrote[idx] {
+			wrote[idx] = true
+			e.writes = append(e.writes, idx)
+		}
+	}
+	defer func() {
+		kept := e.writes[:0]
+		for _, idx := range e.writes {
+			if !stored[idx] {
+				kept = append(kept, idx)
+			}
+		}
+		e.writes = kept
+	}()
+	for _, blk := range fn.Blocks {
+		if blk == fn.Recover {
+			continue
+		}
+		for _, ins := range blk.Instrs {
+			b.planWork++
+			if m, ok := ins.(*ssa.MakeClosure); ok {
+				// A closure made here may run at any time: what it writes may happen.
+				if sub, ok := m.Fn.(*ssa.Function); ok {
+					for _, j := range b.closureEffectsFor(sub).writes {
+						addWrite(fvIndexOf(fn, m.Bindings[j]))
+					}
+					for _, j := range b.closureEffectsFor(sub).stores {
+						if idx := fvIndexOf(fn, m.Bindings[j]); idx >= 0 {
+							stored[idx] = true
+							e.stores = append(e.stores, idx)
+						}
+					}
+				}
+				continue
+			}
+			var cc *ssa.CallCommon
+			switch x := ins.(type) {
+			case *ssa.Call:
+				cc = &x.Call
+			case *ssa.Defer:
+				cc = &x.Call
+			case *ssa.Go:
+				cc = &x.Call
+			case *ssa.Store:
+				if fv, ok := x.Addr.(*ssa.FreeVar); ok && !stored[freeVarIndex(fn, fv)] {
+					stored[freeVarIndex(fn, fv)] = true
+					e.stores = append(e.stores, freeVarIndex(fn, fv))
+				}
+				continue
+			default:
+				continue
+			}
+			_, isGo := ins.(*ssa.Go)
+			_, isDefer := ins.(*ssa.Defer)
+			if recv := methodReceiverVal(cc); recv != nil && !isGo {
+				if idx := fvIndexOf(fn, recv); idx >= 0 {
+					if isWriteMutatingMethod(cc) {
+						addWrite(idx)
+					}
+					if isCloseMethodCall(cc) {
+						if cl, ok := ast.closes[cc.Pos()]; ok {
+							e.closes = append(e.closes, closeEffect{idx: idx, pos: cl.pos, desc: cl.recvDesc, deferred: isDefer})
+						}
+					}
+				}
+			} else if recv != nil && isWriteMutatingMethod(cc) {
+				addWrite(fvIndexOf(fn, recv))
+			}
+			if isGo {
+				continue
+			}
+			for _, m := range closuresRunBy(ins) {
+				sub, ok := m.Fn.(*ssa.Function)
+				if !ok {
+					continue
+				}
+				for _, c := range b.closureEffectsFor(sub).closes {
+					if idx := fvIndexOf(fn, m.Bindings[c.idx]); idx >= 0 {
+						e.closes = append(e.closes, closeEffect{idx: idx, pos: c.pos, desc: c.desc, deferred: isDefer || c.deferred})
+					}
+				}
+			}
+		}
+	}
+	return e
+}
+
+// replayClosureEffects emits, at the instruction ins of the creator, the effects of every closure
+// that ins uses. A write is replayed at every use of the closure, a call, a go statement or an
+// escape alike, because the closure may run from there on. A close is replayed only where the
+// closure runs inside the creator's own flow: a call, a defer or a call that takes it as an
+// argument. The slot of each effect is the creator's slot for the variable the closure captured.
+func (fl *funcLowerer) replayClosureEffects(ins ssa.Instruction, ops *[]gusseterr.OpIR) {
+	if _, isPhi := ins.(*ssa.Phi); isPhi {
+		return
+	}
+	var used []*ssa.MakeClosure
+	for _, op := range ins.Operands(nil) {
+		if m, ok := (*op).(*ssa.MakeClosure); ok {
+			used = append(used, m)
+		}
+	}
+	if len(used) == 0 {
+		return
+	}
+	runs := make(map[*ssa.MakeClosure]bool)
+	_, isGo := ins.(*ssa.Go)
+	_, isDefer := ins.(*ssa.Defer)
+	if !isGo {
+		for _, m := range closuresRunBy(ins) {
+			runs[m] = true
+		}
+	}
+	for _, m := range used {
+		sub, ok := m.Fn.(*ssa.Function)
+		if !ok {
+			continue
+		}
+		eff := fl.pkg.closureEffectsFor(sub)
+		if runs[m] {
+			for _, c := range eff.closes {
+				if c.idx >= len(m.Bindings) {
+					continue
+				}
+				fl.pkg.planWork++
+				*ops = append(*ops, gusseterr.OpIR{
+					Kind:    gusseterr.OpUnhandledClose,
+					SiteID:  fl.pkg.addSite(c.pos, c.desc, ""),
+					SlotA:   fl.resourceSlot(m.Bindings[c.idx]),
+					IsDefer: isDefer || c.deferred,
+				})
+			}
+		}
+		for _, idx := range eff.writes {
+			if idx >= len(m.Bindings) {
+				continue
+			}
+			fl.pkg.planWork++
+			*ops = append(*ops, gusseterr.OpIR{Kind: gusseterr.OpMarkWritable, SlotA: fl.resourceSlot(m.Bindings[idx])})
+		}
+	}
+}
+
+// writeIndex records, for one enclosing function, which of the variables it passes to closures may
+// be written: directly in its own body, or by a closure it makes. It is built once per function,
+// so asking about a closure costs a lookup, not a scan of the function.
+type writeIndex struct {
+	direct  map[ssa.Value]bool
+	closure map[ssa.Value][]*ssa.MakeClosure
+}
+
+func (b *packageBuilder) writeIndexFor(parent *ssa.Function) *writeIndex {
+	if wi, ok := b.writeIndexes[parent]; ok {
+		return wi
+	}
+	wi := &writeIndex{direct: make(map[ssa.Value]bool), closure: make(map[ssa.Value][]*ssa.MakeClosure)}
+	b.writeIndexes[parent] = wi
+	for _, blk := range parent.Blocks {
+		if blk == parent.Recover {
+			continue
+		}
+		for _, ins := range blk.Instrs {
+			b.planWork++
+			if m, ok := ins.(*ssa.MakeClosure); ok {
+				if sub, ok := m.Fn.(*ssa.Function); ok {
+					for _, j := range b.closureEffectsFor(sub).writes {
+						wi.closure[m.Bindings[j]] = append(wi.closure[m.Bindings[j]], m)
+					}
+				}
+				continue
+			}
+			var cc *ssa.CallCommon
+			switch x := ins.(type) {
+			case *ssa.Call:
+				cc = &x.Call
+			case *ssa.Defer:
+				cc = &x.Call
+			case *ssa.Go:
+				cc = &x.Call
+			default:
+				continue
+			}
+			if recv := methodReceiverVal(cc); recv != nil && isWriteMutatingMethod(cc) {
+				if load, ok := recv.(*ssa.UnOp); ok && load.Op == token.MUL {
+					recv = load.X
+				}
+				wi.direct[recv] = true
+			}
+		}
+	}
+	return wi
+}
+
+// bindingMayBeWritten reports whether the variable that the creator of a closure passes as binding
+// may be written anywhere in the creator, in a closure other than skip that it makes, or, when the
+// creator is itself a closure, further out. It is flow-insensitive on purpose: it answers only for
+// a closure whose place in the creator's flow is unknown.
+func (b *packageBuilder) bindingMayBeWritten(parent *ssa.Function, skip *ssa.MakeClosure, binding ssa.Value) bool {
+	wi := b.writeIndexFor(parent)
+	if wi.direct[binding] {
+		return true
+	}
+	for _, m := range wi.closure[binding] {
+		if m != skip {
+			return true
+		}
+	}
+	if fv, ok := binding.(*ssa.FreeVar); ok {
+		if grand := parent.Parent(); grand != nil {
+			if gm := b.parentIndexFor(grand).closures[parent]; gm != nil {
+				if idx := freeVarIndex(parent, fv); idx >= 0 && idx < len(gm.Bindings) {
+					return b.bindingMayBeWritten(grand, nil, gm.Bindings[idx])
+				}
+			}
+		}
+	}
+	return false
+}
+
+// seedEscapedCloses marks, at the entry of a closure that closes a captured resource but is not
+// only run inside its creator's flow (it is returned, stored or passed on), the resources that the
+// creator side may have written. The closure cannot see that flow, and a Close error dropped on a
+// resource that may have been written is the unsafe side to miss.
+func (fl *funcLowerer) seedEscapedCloses() {
+	parent := fl.fn.Parent()
+	if parent == nil || len(fl.fn.FreeVars) == 0 {
+		return
+	}
+	eff := fl.pkg.closureEffectsFor(fl.fn)
+	if len(eff.closes) == 0 {
+		return
+	}
+	mc := fl.pkg.parentIndexFor(parent).closures[fl.fn]
+	if mc == nil {
+		return
+	}
+	escapes := false
+	for _, ref := range liveReferrers(mc) {
+		fl.pkg.planWork++
+		inFlow := false
+		for _, run := range closuresRunBy(ref) {
+			if run == mc {
+				inFlow = true
+			}
+		}
+		if _, isGo := ref.(*ssa.Go); isGo || !inFlow {
+			escapes = true
+			break
+		}
+	}
+	if !escapes {
+		return
+	}
+	seeded := make(map[int]bool)
+	for _, c := range eff.closes {
+		if seeded[c.idx] || c.idx >= len(mc.Bindings) {
+			continue
+		}
+		seeded[c.idx] = true
+		if fl.pkg.bindingMayBeWritten(parent, mc, mc.Bindings[c.idx]) {
+			fl.constInits = append(fl.constInits, gusseterr.OpIR{Kind: gusseterr.OpMarkWritable, SlotA: fl.slot(fl.fn.FreeVars[c.idx])})
+		}
+	}
+}
diff --git a/passes/errcheck/closureplan_internal_test.go b/passes/errcheck/closureplan_internal_test.go
index 03e1419..1b244be 100644
--- a/passes/errcheck/closureplan_internal_test.go
+++ b/passes/errcheck/closureplan_internal_test.go
@@ -23,7 +23,13 @@ func closurePlanWork(t *testing.T, n int) uint64 {
 		fmt.Fprintf(&b, "\tvar v%[1]d *T\n\tvar e%[1]d error\n\tfunc() { v%[1]d, e%[1]d = workV() }()\n\tif e%[1]d == nil {\n\t\tn += use(v%[1]d)\n\t}\n\tif c[%[1]d] {\n\t\treturn n\n\t}\n", i)
 	}
 	b.WriteString("\treturn n\n}\n")
-	dir, cleanup, err := analysistest.WriteFiles(map[string]string{"big/big.go": b.String()})
+	return planWorkOf(t, b.String())
+}
+
+// planWorkOf analyzes one package, big/big.go, and returns the plan work counter.
+func planWorkOf(t *testing.T, src string) uint64 {
+	t.Helper()
+	dir, cleanup, err := analysistest.WriteFiles(map[string]string{"big/big.go": src})
 	if err != nil {
 		t.Fatal(err)
 	}
@@ -53,3 +59,37 @@ func TestClosurePlanWorkIsLinear(t *testing.T) {
 		}
 	}
 }
+
+// closureEffectsSource is one function holding n resources, each passed to a closure that writes it,
+// a closure that is called and closes it, and a closure that is kept and closes it later, so every
+// effect path (a replay at a call, a replay at an escape, the entry seed of an escaped closure) runs
+// n times against one parent.
+func closureEffectsSource(n int) string {
+	var b strings.Builder
+	b.WriteString("package big\n\nimport \"io\"\n\nfunc Big(ws []io.WriteCloser) []func() {\n\tvar keep []func()\n")
+	for i := 0; i < n; i++ {
+		fmt.Fprintf(&b, "\tr%[1]d := ws[%[1]d]\n\tfunc() { _, _ = r%[1]d.Write(nil) }()\n\tfunc() { r%[1]d.Close() }()\n\tkeep = append(keep, func() { r%[1]d.Close() })\n", i)
+	}
+	b.WriteString("\treturn keep\n}\n")
+	return b.String()
+}
+
+// Summarising closures and replaying them costs the size of the closures, not closures times the
+// size of the parent: the work per closure is the same constant at 500, 2,000 and 8,000 closures in
+// one parent.
+func TestClosureEffectsWorkIsLinear(t *testing.T) {
+	var per []uint64
+	for _, n := range []int{500, 2000, 8000} {
+		w := planWorkOf(t, closureEffectsSource(n))
+		if w == 0 {
+			t.Fatalf("n=%d: no plan work recorded", n)
+		}
+		t.Logf("n=%d resources: plan work %d (%d per resource)", n, w, w/uint64(n))
+		per = append(per, w/uint64(n))
+	}
+	for i := 1; i < len(per); i++ {
+		if per[i] > per[0]+per[0]/10 {
+			t.Fatalf("work per resource grows with the parent: %v", per)
+		}
+	}
+}
